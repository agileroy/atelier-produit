{
  "rules": {
    ".read": false,
    ".write": false,
    "atelierProduit": {
      "keys": {
        "$sid": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && !root.child('atelierProduit/sessions/' + $sid).exists()) || (!newData.exists() && root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists()))",
          ".validate": "$sid.matches(/^[a-z0-9]{12}$/) && newData.isString() && newData.val().matches(/^[a-z0-9]{24}$/)"
        }
      },
      "sessions": {
        "$sid": {
          ".write": "auth != null && !newData.exists() && root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists()",
          ".validate": "$sid.matches(/^[a-z0-9]{12}$/) && newData.child('meta').exists()",
          "meta": {
            ".read": "auth != null",
            ".write": "auth != null && ((!data.exists() && newData.exists() && newData.parent().child('owners').child(auth.uid).exists()) || (data.exists() && newData.exists() && root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists()))",
            ".validate": "newData.hasChildren(['title', 'step', 'persona', 'closed', 'createdAt'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            },
            "step": {
              ".validate": "newData.isString() && newData.val().matches(/^(frame|empathy|impact|story|debrief)$/)"
            },
            "persona": {
              ".validate": "newData.isString() && newData.val().matches(/^(sophie|karim)$/)"
            },
            "closed": {
              ".validate": "newData.isBoolean()"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === now))"
            },
            "quiz": {
              ".validate": "newData.isString() && newData.val().matches(/^(off|open|revealed)$/)"
            },
            "code": {
              ".validate": "newData.isString() && newData.val().matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/) && (!data.exists() || newData.val() === data.val())"
            },
            "groups": {
              ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2)"
            },
            "restitution": {
              ".validate": "newData.isBoolean()"
            },
            "timer": {
              ".validate": "newData.hasChildren(['step']) && (newData.hasChildren(['endsAt']) || newData.hasChildren(['left']))",
              "step": {
                ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story)$/)"
              },
              "endsAt": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "left": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10800000"
              },
              "over": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "owners": {
            ".read": "auth != null && data.child(auth.uid).exists()",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && newData.exists()",
              ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().parent().child('keys').child($sid).val()"
            }
          },
          "notes": {
            ".read": "auth != null && data.parent().child('owners').child(auth.uid).exists()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              "$nid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('atelierProduit/sessions/' + $sid + '/meta/closed').val() === false && root.child('atelierProduit/sessions/' + $sid + '/meta/step').val() === newData.child('step').val()",
                ".validate": "$nid.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['author', 'step', 'zone', 'persona', 'text', 'createdAt'])",
                "author": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
                },
                "step": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story)$/)"
                },
                "zone": {
                  ".validate": "newData.isString() && ((newData.parent().child('step').val() === 'empathy' && newData.val().matches(/^(says|thinks|does|feels|pains|gains)$/)) || (newData.parent().child('step').val() === 'impact' && newData.val().matches(/^(actor|impact|deliverable)$/)) || (newData.parent().child('step').val() === 'story' && newData.val() === 'story'))"
                },
                "persona": {
                  ".validate": "newData.isString() && ((newData.parent().child('step').val() === 'empathy' && newData.val().matches(/^(sophie|karim)$/)) || (newData.parent().child('step').val() !== 'empathy' && newData.val() === ''))"
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
                },
                "createdAt": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "quiz": {
            ".read": "auth != null && data.parent().child('owners').child(auth.uid).exists()",
            ".write": "auth != null && !newData.exists() && root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('atelierProduit/sessions/' + $sid + '/meta/quiz').val() === 'open'",
              ".validate": "newData.hasChildren(['author', 'placement', 'answers', 'submittedAt'])",
              "author": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
              },
              "placement": {
                ".validate": "newData.hasChildren(['designThinking', 'empathy', 'impact', 'story'])",
                "empathy": {
                  ".validate": "newData.isString() && newData.val().matches(/^(discover|define|develop|deliver|all)$/)"
                },
                "impact": {
                  ".validate": "newData.isString() && newData.val().matches(/^(discover|define|develop|deliver|all)$/)"
                },
                "story": {
                  ".validate": "newData.isString() && newData.val().matches(/^(discover|define|develop|deliver|all)$/)"
                },
                "designThinking": {
                  ".validate": "newData.isString() && newData.val().matches(/^(discover|define|develop|deliver|all)$/)"
                },
                "$other": {
                  ".validate": false
                }
              },
              "answers": {
                ".validate": "newData.hasChildren(['adoption', 'backlog', 'sponsor', 'new-product', 'release', 'two-profiles', 'kpi', 'wrong-problem'])",
                "adoption": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story|designThinking)$/)"
                },
                "backlog": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story|designThinking)$/)"
                },
                "sponsor": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story|designThinking)$/)"
                },
                "new-product": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story|designThinking)$/)"
                },
                "release": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story|designThinking)$/)"
                },
                "two-profiles": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story|designThinking)$/)"
                },
                "kpi": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story|designThinking)$/)"
                },
                "wrong-problem": {
                  ".validate": "newData.isString() && newData.val().matches(/^(empathy|impact|story|designThinking)$/)"
                },
                "$other": {
                  ".validate": false
                }
              },
              "submittedAt": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "names": {
            "$key": {
              ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
              ".validate": "$key.matches(/^[a-z0-9]{1,30}$/) && newData.isString() && newData.val() === auth.uid"
            }
          },
          "presence": {
            ".read": "auth != null && data.parent().child('owners').child(auth.uid).exists()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['author', 'at'])",
              "author": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "members": {
            ".read": "auth != null && data.parent().child('owners').child(auth.uid).exists()",
            ".write": "auth != null && root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['group'])",
              "group": {
                ".validate": "newData.isString() && newData.val().matches(/^g[12]$/)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "boards": {
            "$g": {
              ".read": "auth != null && (root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists() || root.child('atelierProduit/sessions/' + $sid + '/members/' + auth.uid + '/group').val() === $g || (root.child('atelierProduit/sessions/' + $sid + '/meta/restitution').val() === true && root.child('atelierProduit/sessions/' + $sid + '/members/' + auth.uid).exists()))",
              ".validate": "$g.matches(/^g[12]$/)",
              "notes": {
                "$nid": {
                  ".write": "auth != null && (root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists() || root.child('atelierProduit/sessions/' + $sid + '/members/' + auth.uid + '/group').val() === $g)",
                  ".validate": "$nid.matches(/^[a-z0-9]{4,24}$/) && newData.hasChildren(['text', 'place', 'order'])",
                  "text": {
                    ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
                  },
                  "place": {
                    ".validate": "newData.isString() && newData.val().matches(/^(empathy\\|(sophie|karim)\\|(says|thinks|does|feels|pains|gains)|tray\\|(impact|story)|goal|journey|backbone|action|action\\|[a-z0-9]{4,24}|(actor|impact|deliverable)\\|[a-z0-9]{4,24}|story\\|[a-z0-9]{4,24}\\|(mvp|r2|later))$/)"
                  },
                  "order": {
                    ".validate": "newData.isNumber()"
                  },
                  "from": {
                    ".validate": "newData.isString() && newData.val().matches(/^(extract:[a-z0-9]+|deliverable:[a-z0-9]+|phone|example)$/)"
                  },
                  "author": {
                    ".validate": "newData.isString() && newData.val().length <= 30"
                  },
                  "kind": {
                    ".validate": "newData.isString() && newData.val().matches(/^(actor|impact|deliverable)$/)"
                  },
                  "keep": {
                    ".validate": "newData.isBoolean()"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "state": {
                "persona": {
                  ".write": "auth != null && newData.parent().parent().parent().parent().child('owners').child(auth.uid).exists()",
                  ".validate": "newData.isString() && newData.val().matches(/^(sophie|karim)$/)"
                },
                "compare": {
                  ".write": "auth != null && root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists()",
                  ".validate": "newData.isBoolean()"
                },
                "journey": {
                  ".write": "auth != null && (root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists() || root.child('atelierProduit/sessions/' + $sid + '/members/' + auth.uid + '/group').val() === $g)",
                  ".validate": "newData.isString() && newData.val().matches(/^(recit|regroup)$/)"
                },
                "done": {
                  "$step": {
                    ".write": "auth != null && (root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists() || root.child('atelierProduit/sessions/' + $sid + '/members/' + auth.uid + '/group').val() === $g)",
                    ".validate": "$step.matches(/^(empathy|impact|story)$/) && newData.isBoolean()"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "kept": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('atelierProduit/sessions/' + $sid + '/owners/' + auth.uid).exists()",
            "$id": {
              ".validate": "$id.matches(/^[a-z0-9]{4,24}$/) && newData.hasChildren(['text', 'group'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
              },
              "group": {
                ".validate": "newData.isString() && newData.val().matches(/^g[12]$/)"
              },
              "order": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "codes": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && root.child('atelierProduit/sessions/' + data.val() + '/owners/' + auth.uid).exists()))",
          ".validate": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{4}$/) && newData.isString() && newData.val().matches(/^[a-z0-9]{12}$/) && newData.parent().parent().child('sessions').child(newData.val()).child('meta').child('code').val() === $code"
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
